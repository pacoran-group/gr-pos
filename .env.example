# Salin file ini ke .env dan sesuaikan dengan kondisi server LAN Grand Royal

# Database bintangnew SISTEM BARU (di Server02) - dipakai gr-pos untuk semua
# pembukuannya (tabel web_*). Terpisah dari MySQL server lagu (154).
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=
DB_NAME=bintangnew

# Port HTTP untuk aplikasi POS baru ini
APP_PORT=4000

# Secret untuk JWT - GANTI dengan string acak yang panjang & rahasia sebelum production
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
JWT_EXPIRES_IN=12h

# Lock wait timeout (detik) - lihat desain-teknis-room-billing.md bagian 2.1
DB_LOCK_WAIT_TIMEOUT_SECONDS=5

# Soft-lock UX TTL (detik) - lihat desain-teknis-room-billing.md bagian 2.2
SOFT_LOCK_TTL_SECONDS=120

# Alokasi waktu karaoke: jam per kelipatan threshold. Default 2 = memenuhi
# threshold dapat 2 jam, belanja 2x threshold dapat 4 jam, dst (proporsional).
CREDIT_HOURS_PER_THRESHOLD=2

# --- Sinkronisasi player room ke server LAMA (154) ---
# Player di dalam room polling m_room.is_active di MySQL server 154. Saat
# buka/tutup/batal kamar (non Mode-Test), gr-pos mengantre perintah dan
# worker mengirim UPDATE m_room SET is_active=? ke 154. Lihat
# migration 003_room_player_outbox.sql & services/roomPlayer.service.js.
#
# ROOM_PLAYER_SYNC=off  -> gr-pos TIDAK menyentuh 154 (kill-switch / dev).
# ROOM_PLAYER_SYNC=on   -> aktif; LEGACY_DB_* wajib diisi.
ROOM_PLAYER_SYNC=off
LEGACY_DB_HOST=10.0.0.154
LEGACY_DB_PORT=3306
LEGACY_DB_USER=grpos_sync
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=bintangnew
ROOM_PLAYER_SYNC_INTERVAL_MS=3000
ROOM_PLAYER_STALE_MINUTES=10

# Sinkron master-data dari 154 -> Server02. Jalan kalau ROOM_PLAYER_SYNC=on.
# Interval ini HANYA menyinkron tabel FAST (m_category/m_product/m_member),
# dengan fingerprint-skip (lewati tabel yang isinya tak berubah). Tabel SLOW
# (m_room/m_promo/tax_service) hanya disinkron saat startup + tombol manual
# di halaman Setelan. Default 300000 ms (5 menit).
MASTER_SYNC_INTERVAL_MS=300000

# --- Cache status room dari server lama 154 (migration 005) ---
# Worker read-only: SELECT room_id,is_active FROM m_room di 154 tiap N ms,
# di-simpan ke web_legacy_room_state. buka-kamar pakai cache ini dulu;
# query langsung ke 154 hanya kalau cache lebih tua dari STALE_MS.
LEGACY_ROOM_STATE_POLL_MS=15000
LEGACY_ROOM_STATE_STALE_MS=45000

# Reconcile arah OFF: izinkan gr-pos MEMATIKAN room di 154 yang gr-pos yakin
# sudah ditutup tapi masih is_active=1. DEFAULT off. Nyalakan (on) HANYA
# kalau gr-pos sudah jadi SATU-SATUNYA pengendali room (aplikasi lama tidak
# lagi dipakai buka/tutup kamar). Kalau masih operasi paralel / Plan B,
# biarkan off supaya gr-pos tidak mematikan room yang dibuka aplikasi lama.
LEGACY_RECONCILE_OFF=off

# --- Identitas unit & sub-gudang (modul Inventory - migration 004) ---
# Dipakai men-stamp unit_id/warehouse_id di web_product_stock &
# web_stock_movement supaya skema siap dikonsolidasikan ke sistem pusat
# (grup Pancoran: banyak unit). Untuk venue tunggal, default aman dipakai
# apa adanya - tapi isi eksplisit sebelum >1 unit menulis ke DB pusat.
UNIT_ID=KRK-PANCORAN
UNIT_NAME=Karaoke Pancoran
WAREHOUSE_ID=WH-KRK-PANCORAN
# on  -> tiap mutasi stok ditulis juga ke web_sync_outbox (untuk worker pusat, fase berikutnya)
# off -> jangan tulis outbox (endpoint pusat belum ada / tak mau baris menumpuk)
SYNC_OUTBOX_ENABLED=on

# --- Laporan Tutup Hari / End-of-Day (modul Reports, migration 006) ---
# Jam batas hari usaha (0-23). Karaoke jalan lewat tengah malam: hari usaha
# D mencakup transaksi yang end_time-nya di [D 05:00, (D+1) 05:00). Waktu
# server DIANGGAP WIB (UTC+7, tanpa DST). Default 5.
EOD_CUTOFF_HOUR=5
# Penerima email laporan (pisah dengan koma). CC opsional.
EOD_REPORT_RECIPIENTS=owner@example.com,manajer@example.com
EOD_REPORT_CC=
# SMTP pengirim email (paket nodemailer sudah terpasang).
# SMTP_SECURE=on -> port 465/SSL; off -> 587/STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=off
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GR POS <no-reply@grandroyal.local>

# --- Modul F&B Hotel (migration 007) ---
# Order F&B tamu hotel diinput kasir karaoke, tercatat terpisah dari omzet
# karaoke, di-posting manual ke folio oleh front desk. SC hotel INKLUSIF
# (harga menu = harga final; komponen SC dihitung mundur untuk info).
HOTEL_UNIT_ID=HOTEL-PANCORAN
HOTEL_NAME=Hotel Pancoran
HOTEL_FNB_SC_PCT=7
# Penerima email rekap harian F&B hotel (front desk / finance hotel), pisah koma.
HOTEL_FNB_RECIPIENTS=frontdesk@example.com
HOTEL_FNB_CC=
